# LOCAL DEV ONLY (.env, next to package.json) — for "npm run dev" on your PC.
# These do NOT get used in production; Vercel uses its own env vars instead
# (see the "Deploying to Vercel" section in README.md).

APP_PASSPHRASE=choose-any-password-here

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Only needed locally to simulate the cron job — see README for how.
CRON_SECRET=any-random-string-for-local-testing

# Optional — only needed if you want AI-written birthday messages instead
# of the built-in template. Google's Gemini API has a genuinely free tier
# (no credit card, no expiration) — get a key at aistudio.google.com/apikey.
# If this is left blank, the app automatically uses a reliable built-in
# template instead — nothing breaks either way.
GEMINI_API_KEY=
